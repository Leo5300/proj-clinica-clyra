{
  "expo": {
    "name": "clyra",
    "slug": "clyra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/imgs/icone-clyra.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/imgs/logo-CLYRA.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/imgs/icone-clyra.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/imgs/icone-clyra.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}