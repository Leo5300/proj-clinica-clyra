# Copie este arquivo para .env.local (front/.env.local) e preencha
# com o IPv4 da SUA máquina na rede Wi-Fi atual (rode "ipconfig" no
# Windows ou "ifconfig"/"ip a" no Mac/Linux para descobrir).
# .env.local NÃO deve ser commitado -- cada dev tem o seu.
EXPO_PUBLIC_API_HOST=192.168.0.10

# Chave do Google Maps. So o mapa de um BUILD Android usa; no Expo Go nao
# precisa (e pode ficar vazia). Crie a chave no Google Cloud Console como
# descrito no README ("Chave do Google Maps") e cole o valor no seu
# front/.env.local -- nunca aqui, nunca no app.json, nunca no Git.
# Sem o prefixo EXPO_PUBLIC_ de proposito: assim a chave nao entra no pacote
# JavaScript do app, so no build nativo (veja front/app.config.js).
GOOGLE_MAPS_API_KEY=
