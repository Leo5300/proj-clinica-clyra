# Credenciais do Twilio para o servidor/gateway-sms-twilio.js
#
# 1. Copie este arquivo para servidor/.env  (sem o ".exemplo")
# 2. Preencha com os dados do Console do Twilio (https://console.twilio.com)
# 3. Na pasta front, rode: npm run gateway:twilio
#
# NUNCA faca commit do .env - quem tem o Auth Token, tem a conta.

# Account Info, na pagina inicial do Console (comeca com AC)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Account Info, na pagina inicial do Console (botao "Show")
TWILIO_AUTH_TOKEN=coloque_aqui_o_auth_token

# Numero do Twilio que envia o SMS, no formato E.164
TWILIO_NUMERO=+15551234567

# --- Opcionais ---

# So para conta TRIAL: ela nao aceita texto livre, apenas modelos prontos.
# Descomente para que todo SMS saia com este modelo. Outros modelos:
# sms_2fa, sms_order_confirmation, sms_delivery_updates, sms_account_alerts
# TWILIO_MODELO_TRIAL=sms_appointment_reminders

# Estimativa em reais por segmento, para o contador do app (padrao 0.35)
# CUSTO_ESTIMADO_BRL=0.35
